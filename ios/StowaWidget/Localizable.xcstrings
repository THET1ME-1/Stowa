    "pick.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a note"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать заметку"
          }
        },
        "uk": {
          "stringUnit": {
