    "pick.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty for a random note every day"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не выбрана — каждый день случайная"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вибрана — щодня випадкова"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen für jeden Tag eine zufällige"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacío: una al azar cada día"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puste — codziennie losowa"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gol — în fiecare zi una la întâmplare"
          }
        }
