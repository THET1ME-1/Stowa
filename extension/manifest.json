{
  "manifest_version": 3,
  "name": "Stowa",
  "description": "Stowa in the browser side panel: write a thought or find a note without leaving the page.",
  "version": "0.1.0",
  "action": { "default_title": "Stowa" },
  "side_panel": { "default_path": "panel.html" },
  "sidebar_action": { "default_panel": "panel.html", "default_title": "Stowa" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "permissions": ["sidePanel"],
  "host_permissions": ["https://stowa.work/*"],
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "browser_specific_settings": { "gecko": { "id": "panel@stowa.work", "strict_min_version": "121.0" } }
}
